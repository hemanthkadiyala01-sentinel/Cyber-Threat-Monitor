# Cyber-Threat-Monitor v0.8

# Frontend
VITE_API_URL=http://127.0.0.1:8000/api

# Backend persistence
CTM_DB_PATH=backend/data/cyber_threat_monitor.db

# Wazuh ingestion
WAZUH_INGEST_API_KEY=change-me
WAZUH_ALERTS_FILE=/var/ossec/logs/alerts/alerts.json
CTM_API_URL=http://127.0.0.1:8000/api/ingest/wazuh
WAZUH_POLL_SECONDS=1

# Application
VITE_APP_NAME=Cyber-Threat-Monitor
VITE_APP_VERSION=0.8.0
